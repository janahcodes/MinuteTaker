# Rendered by the nginx image's envsubst step at container start.
server {
    listen 8080;
    server_name _;

    client_max_body_size ${MAX_UPLOAD_MB}m;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    root /usr/share/nginx/html;

    # Liveness/readiness for the web tier itself (no upstream dependency).
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;          # stream uploads straight through
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        # Try another API pod if the first one is down or refuses the connection.
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
